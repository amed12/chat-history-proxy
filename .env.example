# Konfigurasi chat-history-proxy (cmd/chat-history-proxy). Salin ke .env
# dan isi nilai asli — file .env TIDAK boleh masuk git (lihat .gitignore).
# Ganti klien = ganti isi file ini saja, tidak ada satu baris kode pun yang
# perlu diubah.

# Port HTTP layanan ini
APP_PORT=8081

# Kredensial server Qiscus untuk app klien — WAJIB diisi, service akan
# gagal start kalau kosong. Jangan pernah commit nilai asli.
QISCUS_APP_ID=your_qiscus_app_id_here
QISCUS_SECRET_KEY=your_qiscus_secret_key_here
QISCUS_BASE_URL=https://api3.qiscus.com

# Public key RSA (PEM) untuk memverifikasi JWT yang diterbitkan backend auth
# klien sendiri (bukan oleh layanan ini). WAJIB diisi.
# Contoh: JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY=

# Umur cache daftar sesi per user, dalam detik. Opsional, default 60.
CACHE_TTL_SECONDS=60
