services:
  chat-history-proxy:
    build: .
    ports:
      - "8081:8081"
    environment:
      - APP_PORT=8081
      - QISCUS_APP_ID=<YOUR_QISCUS_APP_ID>
      - QISCUS_SECRET_KEY=<YOUR_QISCUS_SECRET_KEY>
      - QISCUS_BASE_URL=https://api3.qiscus.com
      - JWT_PUBLIC_KEY=<YOUR_RSA_PUBLIC_KEY_PEM>
      - CACHE_TTL_SECONDS=60
